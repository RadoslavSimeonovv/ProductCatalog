{
  "ConnectionStrings": {
    "Database": "Host=productcatalog.db;Port=5432;Database=productcatalog;Username=postgres;Password=postgres;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://productcatalog.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Authentication": {
    "Audience": "productcatalog-auth-client",
    "Issuer": "http://localhost:18080/realms/ProductCatalog",
    "MetadataUrl": "http://productcatalog.idp:8080/realms/ProductCatalog/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  }
}
